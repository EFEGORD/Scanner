<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifiesto de privacidad de UltraScanner. El código de la app no recopila datos ni rastrea:
  los documentos, su texto y el índice del buscador viven cifrados en el iPhone y nunca se
  envían. El SDK de anuncios de Google trae su propio manifiesto con lo que recopila.
  API con motivo declarado: UserDefaults, solo para los ajustes de la propia app (bloqueo con
  Face ID, formato al compartir, si ya se vio el tutorial).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
